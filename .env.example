# Runtime. No Supabase use a SESSION pooler (porta 5432), NAO a transaction pooler (6543).
# O Scheduling Engine usa transacao interativa com isolationLevel Serializable, que nao
# sobrevive ao pooling por transacao. A 6543 quebra o agendamento sob concorrencia.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/convexa?schema=public"

# Apenas para prisma migrate: conexao direta. Sem ela, o migrate usa a DATABASE_URL.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/convexa?schema=public"

# A sessao do banco PRECISA estar em TimeZone UTC: as colunas de instante sao
# timestamptz e o @prisma/adapter-pg nao converte offset. A API checa no boot
# (assertUtcSession em src/shared/database/prisma.ts) e recusa subir fora de UTC.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Pool de conexoes, POR INSTANCIA da API. Os defaults abaixo assumem um Postgres
# dedicado (o do compose do piloto). Num banco compartilhado, some o uso dos
# outros clientes antes de subir DATABASE_POOL_MAX.
# Pool maior nao aumenta throughput aqui: as transacoes do agendamento sao
# Serializable, entao mais concorrencia na mesma agenda vira mais conflito e
# mais retry para entregar o mesmo resultado.
DATABASE_POOL_MAX=5
# Quanto uma requisicao espera por uma conexao livre antes de falhar. Precisa
# ficar abaixo do limite do /health/ready (3s), senao o healthcheck acusa o
# banco quando o problema e fila de pool.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
# Precisa ser MENOR que o limite de transacao do Prisma (5s). Se o Prisma
# desistir primeiro, o ROLLBACK fica na fila atras da query em andamento e a
# conexao so volta quando ela terminar sozinha.
DATABASE_STATEMENT_TIMEOUT_MS=3000
# Atencao no Supabase: via session pooler esses ajustes NAO funcionam se
# enviados na conexao; a API aplica cada um com SET em toda conexao nova.


# Em producao gere cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET e INTERNAL_API_KEY precisam ser diferentes. Placeholder, palavra de
# exemplo ou pouca variedade de caracteres impedem a API de subir em producao.
JWT_SECRET="troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

INTERNAL_API_KEY="troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres"

CORS_ORIGINS="http://localhost:5173"

APP_URL="http://localhost:5173"
PASSWORD_RESET_TTL_MINUTES=30

# Driver de e-mail. "console" imprime o e-mail no terminal, inclusive o link de
# redefinicao de senha com token valido: use SO na maquina local. Fora de test, a
# API nao sobe sem RESEND_API_KEY ou MAIL_DRIVER=console, e recusa console em producao.
MAIL_DRIVER="console"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="Convexa <nao-responda@seudominio.com>"

# Documentacao da API em /docs e /docs/openapi.json, sem exigir token.
# Sem a variavel: ligada fora de producao, desligada em producao.
# Ligar em producao expoe a superficie inteira da API (nao expoe credencial).
DOCS_ENABLED="true"

# --- Ordem de release (nao mude) ---------------------------------------------
#   npm ci
#   npm run build            # roda prisma generate e compila para dist/
#   npm run migrate:deploy   # passo separado. NUNCA migrate dev, NUNCA dentro do start
#   npm run prune:prod       # remove o CLI do prisma da arvore (41MB e as 4 vulns high)
#   npm start
#
# O prune vem DEPOIS do migrate:deploy porque os dois precisam do CLI. Nenhuma flag
# de npm ci tira o CLI: ele e peerDependency opcional de @prisma/client e o npm o
# instala mesmo com --omit=dev --omit=peer. O runtime nao precisa dele -- so do
# client ja gerado. O npm audit continua acusando as 4 high depois do prune porque
# le o package-lock, nao a arvore em disco.
